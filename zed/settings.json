
// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    // Whether to colorize matching brackets (rainbow brackets)
    // https://zed.dev/docs/reference/all-settings#colorize-brackets
    "icon_theme": "Colored Zed Icons Theme Dark",
    "colorize_brackets": true,

    // Whether and how to display code lenses from language servers
    // https://zed.dev/docs/reference/all-settings#code-lens
    "code_lens": "on",
    "auto_signature_help": true,
    "edit_predictions": {
        "provider": "zed",
    },
    "status_bar": {
        "experimental.show": true,
    },
    "gutter": {
        "line_numbers": true,
    },
    "relative_line_numbers": "enabled",
    "vertical_scroll_margin": 8,
    "show_edit_predictions": true,
    "cli_default_open_behavior": "existing_window",
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
    },
    "tab_bar": {
        "show": true,
    },
    "tabs": {
        "show_diagnostics": "errors",
    },
    "horizontal_scroll_margin": 8,
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "session": {
        "trust_all_worktrees": true,
    },
    "vim_mode": true,
    "vim": {
        "use_system_clipboard": "always",
        "use_smartcase_find": true,
    },
    "base_keymap": "Emacs",
    "ui_font_size": 16,
    "buffer_font_size": 15,
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "Kanagawa Wave - No Italics",
    },
    "command_aliases": {
        "W": "w",
        "Wq": "wq",
        "Q": "q",
    },
    "git": {
        "inline_blame": {
            "enabled": false,
        },
    },
    "tab_size": 4,
}
